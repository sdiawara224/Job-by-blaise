{
  "name": "job-by-blaise",
  "version": "1.0.0",
  "description": "Job by blaise — Trouve les offres qui te correspondent. Plateforme d'emploi Guinée & Afrique de l'Ouest.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.js",
    "seed": "node server/seed.js",
    "test:smoke": "node smoke-test.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "express": "4.19.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.1",
    "esbuild": "0.21.5",
    "jsdom": "30.1.3",
    "vite": "5.4.8"
  }
}
