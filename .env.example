# Copier vers .env.local pour le développement (fichier ignoré par Git).
# Générer un secret avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JBB_SECRET=
# Compte(s) EXISTANT(S), créés avec npm run admin:create. Aucun rôle administrateur par défaut.
ADMIN_EMAILS=
# Optionnel : échéance ISO UTC d’un accès temporaire, vérifiée à chaque requête.
ADMIN_ACCESS_EXPIRES_AT=
# Optionnel, serveur uniquement : ne jamais préfixer par VITE_.
SUPABASE_URL=
SUPABASE_KEY=
